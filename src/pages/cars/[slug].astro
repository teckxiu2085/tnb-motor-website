---
import type { GetStaticPaths } from 'astro';
import { Image, Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CarCard from '../../components/CarCard.astro';
import Icon from '../../components/Icon.astro';
import LoanEstimator from '../../components/LoanEstimator.astro';
import NoPhotoPoster from '../../components/NoPhotoPoster.astro';
import ShareButton from '../../components/ShareButton.astro';
import StickyContact from '../../components/StickyContact.astro';
import TriBar from '../../components/TriBar.astro';
import TnbStandard from '../../components/TnbStandard.astro';
import { getVehicles, isLandscape, relatedTo, type Vehicle } from '../../data/vehicles';
import { company, wazeUrl } from '../../data/company';
import { ASK_FOR_PRICE, ASK_OUR_TEAM, formatRM } from '../../lib/format';
import { absoluteUrl, carPath, withBase } from '../../lib/url';
import { messages, waLink } from '../../lib/whatsapp';

export const getStaticPaths = (async () => {
  const vehicles = await getVehicles();
  return vehicles.map((car) => ({ params: { slug: car.slug }, props: { car } }));
}) satisfies GetStaticPaths;

interface Props {
  car: Vehicle;
}
const { car } = Astro.props;

const all = await getVehicles();
const related = relatedTo(car, all);
const url = absoluteUrl(carPath(car.slug), Astro.site);
const cash = formatRM(car.cashPriceRM);
const loan = formatRM(car.loanPriceRM);
const hasPhoto = car.photos.length > 0;
// The frame follows the cover photo (portrait 3:4 or landscape 4:3); other photos that don't match are shown whole.
const landscapeCover = hasPhoto && isLandscape(car.photos[0]);
const wa = waLink(messages.car(car, url));
const waPhotos = hasPhoto ? null : waLink(messages.photos(car, url));
const label = car.label;
const knownTransmission = car.transmission !== ASK_OUR_TEAM;

const priceText = cash ? `Cash price ${cash}` : loan ? `Loan price ${loan}` : 'Ask for price';
const description = `${[car.title, car.colour, knownTransmission ? car.transmission : ''].filter(Boolean).join(', ')}${car.regYear ? `, registered ${car.regYear}` : ''}. ${priceText}. Available at ${company.brandName}, ${company.city}, ${company.state}${company.phone ? ` — WhatsApp ${company.phone}` : ''}.`;

const stickyLabel = cash ? 'Cash price' : loan ? 'Loan price' : 'Price';
const stickyValue = cash ?? loan ?? ASK_FOR_PRICE;

const carLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Car',
  name: label,
  url,
  brand: { '@type': 'Brand', name: car.brand },
  model: car.model,
  vehicleModelDate: String(car.year),
  ...(car.regYear ? { dateVehicleFirstRegistered: String(car.regYear) } : {}),
  ...(car.colour ? { color: car.colour } : {}),
  ...(knownTransmission ? { vehicleTransmission: car.transmission } : {}),
  itemCondition: 'https://schema.org/UsedCondition',
  ...(hasPhoto ? { image: absoluteUrl(`og/${car.slug}.jpg`, Astro.site) } : {}),
  ...(car.cashPriceRM
    ? {
        offers: {
          '@type': 'Offer',
          price: car.cashPriceRM,
          priceCurrency: 'MYR',
          url,
          seller: { '@type': 'AutoDealer', name: company.legalName },
        },
      }
    : {}),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'Cars', item: absoluteUrl('cars/', Astro.site) },
    { '@type': 'ListItem', position: 3, name: label, item: url },
  ],
};
---

<Layout
  title={`${label} | TnB MOTOR Pasir Gudang`}
  description={description}
  path={carPath(car.slug)}
  image={hasPhoto ? `og/${car.slug}.jpg` : undefined}
  imageAlt={label}
  current="cars"
  floatingWhatsApp={false}
  bodyClass="has-sticky-contact"
  jsonLd={[carLd, breadcrumbLd]}
>
  <article class="car">
    <div class="car__media">
      <div
        class:list={['car__media-inner', { 'car__media-inner--poster': !hasPhoto, 'car__media-inner--landscape': landscapeCover }]}
        style={`view-transition-name: car-${car.slug}`}
      >
        {
          hasPhoto ? (
            <div class="gallery" tabindex={car.photos.length > 1 ? 0 : undefined} aria-label={car.photos.length > 1 ? 'Photos' : undefined}>
              {car.photos.map((photo, i) =>
                i === 0 ? (
                  <Picture
                    src={photo}
                    alt={label}
                    widths={[480, 750, 1080, 1440]}
                    sizes="(min-width: 900px) 56vw, 100vw"
                    formats={['avif']}
                    fallbackFormat="webp"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />
                ) : (
                  // More photos: WebP only (every current browser shows it), two sizes — keeps builds fast.
                  <Image
                    src={photo}
                    alt={`${label}, photo ${i + 1}`}
                    widths={[750, 1440]}
                    sizes="(min-width: 900px) 56vw, 100vw"
                    format="webp"
                    loading="lazy"
                    decoding="async"
                    class={isLandscape(photo) === landscapeCover ? undefined : 'gallery__whole'}
                  />
                ),
              )}
            </div>
          ) : (
            <NoPhotoPoster car={car} size="hero" />
          )
        }
      </div>
      {hasPhoto && car.photos.length > 1 && <p class="gallery__hint">Swipe for more photos · {car.photos.length}</p>}
    </div>

    <div class="car__info">
      <a class="car__back text-link" href={withBase('cars/')} data-back>
        <Icon name="arrow" class="car__back-icon" />
        All cars
      </a>

      <header class="car__head">
        <p class="eyebrow">{car.brand}</p>
        <h1 class="car__title">{car.model}</h1>
        <p class="car__meta mono">{[car.yearLabel, car.colour, car.transmission].filter(Boolean).join(' · ')}</p>
        <TriBar />
      </header>

      <section class="price" aria-label="Price">
        <div class="price__grid">
          <div>
            <p class="price__label">Cash price</p>
            <p class="price__value mono">{cash ?? ASK_FOR_PRICE}</p>
          </div>
          <div>
            <p class="price__label">Loan price</p>
            <p class="price__value mono">{loan ?? ASK_FOR_PRICE}</p>
          </div>
        </div>
        {
          company.pricingNotes.length > 0 && (
            <ul class="price__notes">
              {company.pricingNotes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          )
        }
      </section>

      <div class="car__actions">
        {
          wa && (
            <a class="btn btn--red btn--block" href={wa} target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              WhatsApp about this car
            </a>
          )
        }
        {
          waPhotos && (
            <a class="btn btn--outline btn--block" href={waPhotos} target="_blank" rel="noopener">
              <Icon name="camera" />
              Request photos on WhatsApp
            </a>
          )
        }
        <div class="car__actions-row">
          {
            company.phoneE164 && (
              <a class="btn btn--outline" href={`tel:${company.phoneE164}`}>
                <Icon name="phone" />
                Call
              </a>
            )
          }
          <ShareButton url={url} title={`${label} — TnB MOTOR`} text={`${label} at TnB MOTOR, ${company.city}`} />
        </div>
      </div>

      <TnbStandard variant="compact" />

      <section class="specs" aria-labelledby="specs-title">
        <h2 class="section-label" id="specs-title">Specifications</h2>
        <dl>
          <div>
            <dt>Year</dt>
            <dd class="mono">{car.year}</dd>
          </div>
          {
            car.regYear && (
              <div>
                <dt>Registered</dt>
                <dd class="mono">{car.regYear}</dd>
              </div>
            )
          }
          <div>
            <dt>Colour</dt>
            <dd>{car.colour || ASK_OUR_TEAM}</dd>
          </div>
          <div>
            <dt>Transmission</dt>
            <dd>{car.transmission}</dd>
          </div>
          <div>
            <dt>Mileage</dt>
            <dd>{ASK_OUR_TEAM}</dd>
          </div>
        </dl>
      </section>

      <LoanEstimator car={car} url={url} />

      {
        company.address && (
          <section class="visit-mini" aria-labelledby="visit-mini-title">
            <h2 class="section-label" id="visit-mini-title">
              Visit {company.brandName}
            </h2>
            <p>
              <Icon name="pin" /> {company.address}
            </p>
            {company.openingHours && (
              <p>
                <Icon name="clock" /> {company.openingHours}
              </p>
            )}
            <div class="visit-mini__links">
              {company.googleMapsUrl && (
                <a class="text-link" href={company.googleMapsUrl} target="_blank" rel="noopener">
                  Google Maps <Icon name="arrow" />
                </a>
              )}
              {wazeUrl && (
                <a class="text-link" href={wazeUrl} target="_blank" rel="noopener">
                  Waze <Icon name="arrow" />
                </a>
              )}
            </div>
          </section>
        )
      }
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="related section section--alt" aria-labelledby="related-title">
        <div class="container">
          <div class="section-head section-head--row">
            <h2 class="h2" id="related-title">
              You may also like
            </h2>
            <a class="text-link" href={withBase('cars/')}>
              All cars <Icon name="arrow" />
            </a>
          </div>
          <div class="related__grid">
            {related.map((r) => (
              <CarCard car={r} class="reveal" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <StickyContact wa={wa} label={stickyLabel} value={stickyValue} />
</Layout>

<script>
  // "All cars" goes back to the exact list (filters + scroll) when the visitor came from it.
  const back = document.querySelector<HTMLAnchorElement>('[data-back]');
  back?.addEventListener('click', (e) => {
    try {
      const ref = new URL(document.referrer);
      if (ref.origin === location.origin && ref.pathname === new URL(back.href).pathname && history.length > 1) {
        e.preventDefault();
        history.back();
      }
    } catch {
      /* no referrer */
    }
  });
</script>

<style>
  :global(body.has-sticky-contact) {
    padding-bottom: calc(76px + env(safe-area-inset-bottom));
  }
  @media (min-width: 900px) {
    :global(body.has-sticky-contact) {
      padding-bottom: 0;
    }
  }

  .car {
    display: grid;
  }
  .car__media-inner {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--surface-2);
    container-type: inline-size;
  }
  .car__media-inner--poster,
  .car__media-inner--landscape {
    aspect-ratio: 4 / 3;
  }
  .gallery {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .gallery::-webkit-scrollbar {
    display: none;
  }
  .gallery > :global(*) {
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: start;
  }
  .gallery :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }
  .gallery :global(img.gallery__whole) {
    object-fit: contain;
  }
  .gallery__hint {
    padding: 10px var(--gutter) 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .car__info {
    display: grid;
    gap: 28px;
    align-content: start;
    width: min(100% - 2 * var(--gutter), 640px);
    margin-inline: auto;
    padding-block: 20px 40px;
  }
  .car__back {
    justify-self: start;
    color: var(--muted);
    min-height: 44px;
  }
  .car__back:hover {
    color: var(--ink);
  }
  .car__back :global(.car__back-icon) {
    transform: rotate(180deg);
  }
  .car__back:hover :global(.car__back-icon) {
    transform: rotate(180deg) translateX(4px);
  }
  .car__head {
    display: grid;
    gap: 12px;
    margin-top: -12px;
  }
  .car__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 8vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .car__meta {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .price {
    display: grid;
    gap: 16px;
  }
  .price__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .price__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .price__value {
    margin-top: 4px;
    font-size: clamp(1.45rem, 6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .price__notes {
    margin: 0;
    padding: 14px 0 0 1.1em;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 4px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .car__actions {
    display: grid;
    gap: 10px;
  }
  .car__actions-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 10px;
  }

  .section-label {
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .specs dl {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .specs dl > div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }
  .specs dt {
    color: var(--muted);
  }
  .specs dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  .visit-mini {
    display: grid;
    gap: 10px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .visit-mini p {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .visit-mini p :global(.icon) {
    margin-top: 2px;
  }
  .visit-mini__links {
    display: flex;
    gap: 24px;
    color: var(--ink);
  }

  .related__grid {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 640px) {
    .related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .related__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .car {
      grid-template-columns: minmax(0, 56fr) minmax(0, 44fr);
      gap: clamp(32px, 4vw, 64px);
      width: min(100% - 2 * var(--gutter), 1400px);
      margin-inline: auto;
      padding-top: 32px;
    }
    .car__media {
      position: sticky;
      top: calc(var(--header-h) + 24px);
      align-self: start;
    }
    .car__media-inner {
      border-radius: var(--radius);
      max-height: calc(100svh - var(--header-h) - 48px);
      aspect-ratio: 3 / 4;
      margin-inline: auto;
    }
    .car__media-inner--poster {
      aspect-ratio: 4 / 5;
    }
    .car__media-inner--landscape {
      aspect-ratio: 4 / 3;
    }
    .car__info {
      width: auto;
      margin: 0;
      padding-top: 0;
    }
  }
</style>
