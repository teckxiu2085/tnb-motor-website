---
// "The TnB Standard": facts confirmed by TnB (content/company.json → whyTnb). Hidden when the list is empty.
import Icon from './Icon.astro';
import { company } from '../data/company';

interface Props {
  variant?: 'full' | 'compact';
}
const { variant = 'full' } = Astro.props;
const icons = { service: 'wrench', warranty: 'shield', accident: 'car', flood: 'no-flood' } as const;
const iconFor = (key: string) => icons[key as keyof typeof icons] ?? 'check';
const items = company.whyTnb;
---

{
  items.length > 0 &&
    (variant === 'full' ? (
      <ul class="standard">
        {items.map((item) => (
          <li class="standard__item reveal">
            <span class="standard__icon">
              <Icon name={iconFor(item.icon)} />
            </span>
            <h3 class="standard__title">{item.title}</h3>
            <p class="standard__text">{item.text}</p>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="standard-strip" aria-label="The TnB Standard">
        {items.map((item) => (
          <li>
            <Icon name={iconFor(item.icon)} />
            {item.title}
          </li>
        ))}
      </ul>
    ))
}

<style>
  .standard {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .standard__item {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    column-gap: 16px;
    row-gap: 4px;
    align-items: start;
    padding: 20px 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .standard__item::after {
    content: '';
    position: absolute;
    left: 22px;
    bottom: 0;
    width: 48px;
    height: 3px;
    background: var(--red);
  }
  .standard__icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--red-tint);
    color: var(--red);
  }
  .standard__icon :global(.icon) {
    width: 26px;
    height: 26px;
  }
  .standard__title {
    margin-top: 2px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.2;
  }
  .standard__text {
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (min-width: 640px) {
    .standard {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .standard__item {
      grid-template-columns: 1fr;
      row-gap: 10px;
      padding: 24px 22px 26px;
    }
    .standard__icon {
      grid-row: auto;
    }
    .standard__title {
      margin-top: 6px;
    }
  }
  @media (min-width: 1100px) {
    .standard {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }
  }

  .standard-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 16px;
    margin: 0;
    padding: 16px 0;
    border-block: 1px solid var(--line);
    list-style: none;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .standard-strip li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .standard-strip :global(.icon) {
    color: var(--red);
  }
</style>
