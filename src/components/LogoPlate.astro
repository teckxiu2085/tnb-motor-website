---
// The official logo is a white-background design (the file has a white background).
// On white it sits directly on the page (`plain`); on any other background it sits on a white rounded plate.
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-trimmed.png';

interface Props {
  /** nav = header logo (38 px on phones, 44 px on bigger screens). */
  size?: 'sm' | 'nav' | 'md' | 'lg';
  /** Only on pure white backgrounds. */
  plain?: boolean;
  class?: string;
}
const { size = 'sm', plain = false, class: className } = Astro.props;
const heights = { sm: 34, nav: 44, md: 56, lg: 96 };
const h = heights[size];
---

<span class:list={['logo-plate', `logo-plate--${size}`, { 'logo-plate--plain': plain }, className]}>
  <Image
    src={logo}
    alt="TnB MOTOR — Used Car Dealer"
    height={h}
    width={Math.round((h * logo.width) / logo.height)}
    densities={[1, 2, 3]}
    format="png"
    loading="eager"
    decoding="async"
  />
</span>

<style>
  .logo-plate {
    display: inline-flex;
    align-items: center;
    background: #fff;
    border-radius: 10px;
    padding: 6px 10px;
    line-height: 0;
    box-shadow: var(--shadow-sm);
  }
  .logo-plate--md {
    border-radius: 14px;
    padding: 10px 16px;
  }
  .logo-plate--lg {
    border-radius: 18px;
    padding: 16px 24px;
  }
  .logo-plate--plain {
    padding: 0;
    box-shadow: none;
  }
  .logo-plate--nav :global(img) {
    width: auto;
    height: 38px;
  }
  @media (min-width: 900px) {
    .logo-plate--nav :global(img) {
      height: 44px;
    }
  }
</style>
