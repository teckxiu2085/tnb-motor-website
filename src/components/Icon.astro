---
// Small inline icons (no icon font, no extra requests).
interface Props {
  name:
    | 'whatsapp'
    | 'phone'
    | 'pin'
    | 'clock'
    | 'share'
    | 'arrow'
    | 'filter'
    | 'search'
    | 'close'
    | 'map'
    | 'navigate'
    | 'camera'
    | 'check'
    | 'wrench'
    | 'shield'
    | 'car'
    | 'no-flood';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class:list={['icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    name === 'whatsapp' && (
      <>
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
          d="M12 2.9a9.1 9.1 0 0 0-7.8 13.8L3 21l4.4-1.2A9.1 9.1 0 1 0 12 2.9Z"
        />
        <path
          fill="currentColor"
          d="M9.1 7.4c.2-.4.4-.4.6-.4h.5c.2 0 .4 0 .6.4l.8 1.9c.1.2.1.4 0 .6l-.5.7c-.1.2-.2.3 0 .6.4.7 1 1.3 1.6 1.8.7.6 1.3.9 1.6 1 .2.1.4.1.5-.1l.7-.8c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.8-.2 1.5-.3.7-1.5 1.3-2.1 1.3-.6.1-1.2.2-3.9-.8-3.2-1.3-5.2-4.6-5.4-4.8-.2-.2-1.2-1.6-1.2-3.1 0-1.5.8-2.2 1.1-2.5Z"
        />
      </>
    )
  }
  {
    name === 'phone' && (
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M21 16.5v2.6a1.8 1.8 0 0 1-2 1.8 17.8 17.8 0 0 1-7.8-2.8 17.5 17.5 0 0 1-5.4-5.4A17.8 17.8 0 0 1 3 4.9 1.8 1.8 0 0 1 4.8 3h2.6a1.8 1.8 0 0 1 1.8 1.5c.1.9.3 1.7.6 2.5a1.8 1.8 0 0 1-.4 1.9L8.3 10a14.4 14.4 0 0 0 5.4 5.4l1.1-1.1a1.8 1.8 0 0 1 1.9-.4c.8.3 1.6.5 2.5.6a1.8 1.8 0 0 1 1.5 1.8Z"
      />
    )
  }
  {
    name === 'pin' && (
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 10c0 5-8 12-8 12s-8-7-8-12a8 8 0 0 1 16 0Z" />
        <circle cx="12" cy="10" r="3" />
      </g>
    )
  }
  {
    name === 'clock' && (
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </g>
    )
  }
  {
    name === 'share' && (
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v12M7.5 7.5 12 3l4.5 4.5" />
        <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" />
      </g>
    )
  }
  {
    name === 'arrow' && (
      <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
    )
  }
  {
    name === 'filter' && (
      <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M4 6h16M7 12h10M10 18h4" />
    )
  }
  {
    name === 'search' && (
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </g>
    )
  }
  {
    name === 'close' && (
      <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M6 6l12 12M18 6 6 18" />
    )
  }
  {
    name === 'map' && (
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Z" />
        <path d="M9 3v15M15 6v15" />
      </g>
    )
  }
  {
    name === 'navigate' && (
      <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M3 11 21 3l-8 18-2-8-8-2Z" />
    )
  }
  {
    name === 'camera' && (
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
        <path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z" />
        <circle cx="12" cy="13.5" r="3.5" />
      </g>
    )
  }
  {
    name === 'wrench' && (
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"
        d="M14.7 6.3a4 4 0 0 0-5.4 5.2L3.6 17.2a1.9 1.9 0 0 0 2.7 2.7l5.7-5.7a4 4 0 0 0 5.2-5.4l-2.6 2.6-2.3-.5-.5-2.3 2.6-2.6Z"
      />
    )
  }
  {
    name === 'shield' && (
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3 4.5 6v5.6c0 4.4 3.1 8.2 7.5 9.4 4.4-1.2 7.5-5 7.5-9.4V6L12 3Z" />
        <path d="m8.8 12 2.3 2.3 4.2-4.6" />
      </g>
    )
  }
  {
    name === 'car' && (
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 16.5V12l1.8-4.6A2 2 0 0 1 8.7 6h6.6a2 2 0 0 1 1.9 1.4L19 12v4.5Z" />
        <path d="M5 12h14M7 16.5V19M17 16.5V19" />
        <circle cx="8" cy="14.2" r=".6" fill="currentColor" />
        <circle cx="16" cy="14.2" r=".6" fill="currentColor" />
      </g>
    )
  }
  {
    name === 'no-flood' && (
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3.5s-5.5 6-5.5 10.2a5.5 5.5 0 0 0 11 0C17.5 9.5 12 3.5 12 3.5Z" />
        <path d="M4 4l16 16" />
      </g>
    )
  }
  {
    name === 'check' && (
      <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m5 12 5 5 9-10" />
    )
  }
</svg>
